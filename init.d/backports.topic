#!/bin/env bash
set -euo pipefail

SOURCE_PATH="$(mktemp "${TMPDIR:-/tmp}/backports.XXXXXX")"
trap 'rm -f "$SOURCE_PATH"' EXIT

cat > "$SOURCE_PATH" <<'EOF'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie-backports
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF

sudo install -o root -g root -m 644 "$SOURCE_PATH" /etc/apt/sources.list.d/backports.sources
sudo apt update \
  -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/backports.sources \
  -o Dir::Etc::sourceparts="" \
  -o APT::Get::List-Cleanup=0 \
  -o APT::Update::Error-Mode=any
