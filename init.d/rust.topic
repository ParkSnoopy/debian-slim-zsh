#!/bin/env bash
set -euo pipefail

sudo apt install -y ca-certificates curl

INSTALLER_PATH="$(mktemp "${TMPDIR:-/tmp}/rust-install.XXXXXX")"
trap 'rm -f "$INSTALLER_PATH"' EXIT
curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o "$INSTALLER_PATH"
sh "$INSTALLER_PATH" -y --default-toolchain stable --profile complete --target x86_64-unknown-linux-gnu --no-modify-path
